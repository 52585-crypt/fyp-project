# Optional for development. Set the deployed HTTPS API origin for release builds.
EXPO_PUBLIC_API_URL=
# Optional local API port. Uses the browser or Metro host and is ignored in release builds.
EXPO_PUBLIC_DEV_API_PORT=4001

# Google OAuth Web application client ID. The same value must be present in
# server/.env GOOGLE_CLIENT_IDS. Add the browser's exact origin (no path) to
# this client's Authorized JavaScript origins in Google Cloud, for example:
# http://localhost:8081 and http://127.0.0.1:8081
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android native build key (restrict by package and signing certificate)
GOOGLE_MAPS_ANDROID_API_KEY=
# Expo Web client key (restrict by website origin)
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Required for the non-Google maps (CARTO Voyager raster tiles). Without it CARTO
# serves an "API KEY REQUIRED" placeholder tile. Get one at carto.com/basemaps/apikey.
# CARTO key is restricted to localhost; add the production domain in the CARTO dashboard
# or use a separate unrestricted key for mobile builds.
EXPO_PUBLIC_CARTO_BASEMAP_API_KEY=your_carto_basemap_api_key

# Public Stripe sandbox key from the same sandbox as the API.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
