    "android:doctor": "bash scripts/android-cli.sh doctor",
    "android:build": "bash scripts/android-cli.sh build",
    "start:native": "expo start --dev-client",
    "test:node": "node --test test/*.test.cjs",
    "test:jest": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
