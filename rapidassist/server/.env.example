NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (keep credentials out of git)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.bpzdyhe.mongodb.net/rapidassist?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (admin panel, Expo web).
# Leave empty only for local development.
CORS_ORIGIN=http://localhost:5173

# Used by `npm run create-admin` (or pass --phone / --password flags instead)
ADMIN_NAME=RapidAssist Admin
ADMIN_PHONE=
ADMIN_PASSWORD=

# Failed sign-in lockout (admin: this many failures; app users: double)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
