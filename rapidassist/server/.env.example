NODE_ENV=development
# Server-only Places API (New) key. Restrict by API and server egress IP when possible.
# Do not expose this key to mobile or web clients.
GOOGLE_MAPS_SERVER_API_KEY=
PLACES_RATE_LIMIT_PER_MINUTE=60
# The default for npm start. With a Stripe QA listener on 4000, set PORT=4001
# and the URI of a separate development MongoDB in .env.development.local.
PORT=4000

# MongoDB Atlas connection string (keep credentials out of git)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.bpzdyhe.mongodb.net/rapidassist?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth client IDs accepted as ID-token audiences (comma-separated).
# Include the Web client ID used by the mobile app and the iOS client ID if its tokens use that audience.
GOOGLE_CLIENT_IDS=

# Admin account created/updated when the API starts
ADMIN_EMAIL=admin@rapidassist.pk
ADMIN_PASSWORD=replace_with_at_least_10_characters
ADMIN_PHONE=admin-system
ADMIN_NAME=RapidAssist Admin

# Batch dispatch routing. OSRM failures are recorded as haversine_fallback.
OSRM_TABLE_URL=https://router.project-osrm.org/table/v1/driving
# Set to fallback only for offline demos; omit it to use OSRM road travel times.
DISPATCH_ROUTING_MODE=osrm

# AI service recommendation. Keep GROQ_API_KEY only in server/.env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=12000
AI_RATE_LIMIT_PER_MINUTE=10

# Mechanic verification uses the rapidassist AWS CLI login in development
# and the AWS SDK role credential chain in production.
AWS_REGION=ap-south-1
MECHANIC_VERIFICATION_BUCKET=rapidassist-mechanic-kyc-2026-unique789

# Exact trusted browser origins, comma-separated. Required in production.
# Include the admin and Expo Web origins; add explicit LAN origins when needed.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# Stripe sandbox only. Use the signing secret from your test webhook endpoint
# or Stripe CLI listener. Stripe confirmation requires a MongoDB replica set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Free local AI (no API keys needed)
# Set to false to skip loading the face / CLIP models when the server starts
AI_PRELOAD=true
# Head-turn liveness: max head-turn score for the straight selfie (~0.1 = 10 degrees)
FACE_MAX_FRONT_YAW=0.1
# Each turned selfie must differ from the straight one by at least this (~0.12 = 12-15 degrees)
FACE_MIN_TURN_YAW=0.12
# face-api distance: below this = same person across the 3 selfies
FACE_SAME_PERSON_DISTANCE=0.6
# Stricter distance for flagging a duplicate provider account
FACE_DUPLICATE_DISTANCE=0.45
# CLIP photo-to-service suggestion: minimum confidence to auto-select a service
VEHICLE_ISSUE_MIN_CONFIDENCE=0.3
