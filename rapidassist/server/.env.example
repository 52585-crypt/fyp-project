NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (keep credentials out of git)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.bpzdyhe.mongodb.net/rapidassist?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Free local AI (no API keys needed)
# Set to false to skip loading the face / CLIP models when the server starts
AI_PRELOAD=true
# Head-turn liveness: max head-turn score for the straight selfie (~0.1 = 10 degrees)
FACE_MAX_FRONT_YAW=0.1
# Each turned selfie must differ from the straight one by at least this (~0.12 = 12-15 degrees)
FACE_MIN_TURN_YAW=0.12
# face-api distance: below this = same person across the 3 selfies
FACE_SAME_PERSON_DISTANCE=0.6
# Stricter distance for flagging a duplicate provider account
FACE_DUPLICATE_DISTANCE=0.45
# CLIP photo-to-service suggestion: minimum confidence to auto-select a service
VEHICLE_ISSUE_MIN_CONFIDENCE=0.3
